{
  "manifest_version": 3,
  "name": "Fill It Pro",
  "version": "1.0.0",
  "description": "Auto-fill web forms and PDF templates from uploaded documents using AI.",
  "permissions": ["activeTab", "storage", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill It Pro"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["form-profiles/*.json", "lib/*", "templates/*"],
      "matches": ["<all_urls>"]
    }
  ]
}