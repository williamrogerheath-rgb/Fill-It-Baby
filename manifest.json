{
  "manifest_version": 3,
  "name": "Fill It Baby",
  "version": "0.1.0",
  "description": "Extract data from PDFs using Claude AI and auto-fill web forms.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fill It Baby"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["form-profiles/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
